{
  "name": "quviz-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "codegen": "node scripts/generate-api-types.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "node scripts/clean-coverage.mjs && tsc -p tsconfig.test.json --noEmit && vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/vitest-results.json && node scripts/assert-no-skips.mjs && node scripts/assert-coverage-scope.mjs",
    "test:fullstack": "playwright test --config=playwright.fullstack.config.ts && node scripts/assert-fullstack-run.mjs",
    "test:watch": "vitest",
    "test:visual": "playwright test && node scripts/assert-visual-run.mjs",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.4",
    "lucide-react": "1.33.0",
    "postprocessing": "6.39.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@react-three/test-renderer": "9.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "30.0.1",
    "minimatch": "^10.2.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.2",
    "vite": "8.2.1",
    "vitest": "^3.2.7"
  }
}
