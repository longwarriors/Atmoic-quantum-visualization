    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "^3.2.7",
